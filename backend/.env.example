# =================================================================
# NESTORA BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before starting the backend server
# =================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# Allowed CORS Frontend Origin
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
# Local MongoDB: mongodb://127.0.0.1:27017/nestora
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/nestora?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nestora

# JSON Web Token (JWT) Security
JWT_SECRET=nestora_super_secret_jwt_key_2026_production_grade
JWT_EXPIRES_IN=7d
