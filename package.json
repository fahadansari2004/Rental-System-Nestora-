{
  "name": "nestora-rental-root",
  "version": "1.0.0",
  "description": "Nestora Full-Stack Property Rental Platform (MERN)",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "build": "npm --prefix frontend run build",
    "test": "node backend/tests/masterIntegrationReview.js",
    "test:all": "node backend/tests/masterIntegrationReview.js && node backend/tests/bookingTest.js",
    "seed": "npm --prefix backend run seed",
    "pdf:doc": "node scripts/generateInternshipDocPdf.cjs",
    "start": "npm --prefix backend start"
  },
  "keywords": ["rental", "mern", "property", "nestora", "react", "express", "mongodb"],
  "author": "Nestora Engineering Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
